{
  "include": [
    "./modules/cpu.jsonc",
    "./modules/memory.jsonc",
    "./modules/temperature.jsonc",
    "./modules/wireplumber.jsonc"
  ],

  "custom/system-trigger": {
    "format": "",
    "tooltip": false
  },

  "custom/volume-trigger": {
    "format": "",
    "tooltip": false
  },

  "group/system-monitor": {
    "orientation": "horizontal",
    "modules": ["custom/system-trigger", "cpu", "memory", "temperature"],
    "drawer": {
      "transition-left-to-right": false,
      "click-to-reveal": true
    }
  },

  "group/volume": {
    "orientation": "horizontal",
    "modules": ["custom/volume-trigger",  "wireplumber#input", "wireplumber#output"],
    "drawer": {
      "transition-left-to-right": false,
      "click-to-reveal": true
    }
  }
}
