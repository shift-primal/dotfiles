{
  "wireplumber#output": {
    "format": "<span color='#a6e3a1'>{icon}</span> {volume}%",
    "format-muted": "<span color='#a6adc8'>󰝟</span> {volume}%",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "min-length": 7,
    "max-length": 7,
    "on-click": "~/user_scripts/hyprland/volume.sh mute",
    "on-click-right": "kitty -e wiremix",
    "on-scroll-up": "~/user_scripts/hyprland/volume.sh up",
    "on-scroll-down": "~/user_scripts/hyprland/volume.sh down",
    "tooltip-format": "Device: {node_name}",
    "node-type": "Audio/Sink"
  },

  "wireplumber#input": {
    "format": "<span color='#f38ba8'>󰍬</span> {volume}%",
    "format-muted": "<span color='#a6adc8'>󰍭</span> {volume}%",
    "min-length": 7,
    "max-length": 7,
    "on-click": "~/user_scripts/hyprland/microphone.sh mute",
    "on-click-right": "kitty -e wiremix",
    "on-scroll-up": "~/user_scripts/hyprland/microphone.sh up",
    "on-scroll-down": "~/user_scripts/hyprland/microphone.sh down",
    "tooltip-format": "Device: {node_name}",
    "node-type": "Audio/Source"
  }
}
