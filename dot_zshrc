  # === Path ===
  export PATH="$HOME/.local/bin:$HOME/.dotnet/tools:$HOME/.cargo/bin:$HOME/go/bin:$PATH"

  # === Environment ===
  export EDITOR=nvim
  export VISUAL=nvim

  # === History ===
  HISTFILE=~/.histfile
  HISTSIZE=10000
  SAVEHIST=10000
  setopt HIST_IGNORE_DUPS
  setopt HIST_IGNORE_SPACE
  setopt SHARE_HISTORY

  # === Completion ===
  autoload -Uz compinit
  compinit
  zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

  # === Aliases ===
  alias ff='fastfetch'
  alias py='python'

  alias fixmon='for m in $(hyprctl monitors -j | jq -r ".[].name"); do hyprctl keyword monitor "$m,disable";
   done && sleep 0.5 && hyprctl reload'

  alias conf='cd ~/.config'
  alias lc='cd ~/.local'

  alias currproj='cd ~/Documents/DotNetProjects/pizza-app'
  alias gotocase='cd ~/Documents/case_oppgave_backend'
  alias expenses='cd ~/Documents/OtherProjects/expenses_tracker'

  alias doc='cd ~/Documents'
  alias pic='cd ~/Pictures'
  alias dl='cd ~/Downloads'

  alias sdtui='systemd-manager-tui'

  alias updatechezmoi="~/user_scripts/etc/chezmoi-readd.sh"
  alias hidedesktop="~/user_scripts/etc/hide-desktop-entries.sh"

  # === Prompt ===
  eval "$(oh-my-posh init zsh --config ~/.config/omp/theme.omp.json)"
