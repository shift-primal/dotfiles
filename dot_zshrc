# Direnv 
eval "$(direnv hook zsh)"

# Bitwarden ssh
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"

# Env
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim

export ZSH="$HOME/.oh-my-zsh"

export PNPM_HOME="/home/kasper/.local/share/pnpm"

# Aliases 
alias nvimcfg='cd ~/.config/nvim && nvim .'
alias cfg='cd ~/.config && nvim .'

alias py='python'
alias yay='paru'
alias ff='fastfetch'
alias ls='eza'

alias restartnoc='pkill qs && qs -c noctalia-shell & disown'

# pnpm
export PNPM_HOME="/home/kasper/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end


export DISABLE_AUTO_TITLE='true'

zstyle ':omz:update' mode reminder

DISABLE_AUTO_TITLE="true"
COMPLETION_WAITING_DOTS="true"



plugins=(git aliases archlinux chezmoi colorize zsh-autosuggestions zsh-syntax-highlighting eza zoxide)



export _ZO_DOCTOR=0
source $ZSH/oh-my-zsh.sh
[[ ${TERM:-} != "dumb" ]] && command -v starship &> /dev/null && eval "$(starship init zsh)"


# Added by Antigravity CLI installer
export PATH="/home/kasper/.local/bin:$PATH"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
