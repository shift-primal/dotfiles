# === Anything that requires console input must go above this block ===

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# === Direnv ===
eval "$(direnv hook zsh)"

# === Env ===
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim

export ZSH="$HOME/.oh-my-zsh"

export PNPM_HOME="/home/kasper/.local/share/pnpm"
export STARSHIP_CONFIG=~/.config/starship/config.toml

# === Oh-my-zsh ===

export DISABLE_AUTO_TITLE='true'

zstyle ':omz:update' mode reminder

DISABLE_AUTO_TITLE="true"
COMPLETION_WAITING_DOTS="true"

plugins=(git aliases archlinux chezmoi colorize zsh-autosuggestions zsh-syntax-highlighting eza zoxide)

source $ZSH/oh-my-zsh.sh

# === Custom Aliases ===
alias nvimcfg='cd ~/.config/nvim && nvim .'
alias cfg='cd ~/.config && nvim .'

alias py='python'
alias yay='paru'
alias ff='fastfetch'
alias cd='z'
alias ls='eza'

alias restartnoc='pkill qs && qs -c noctalia-shell & disown'

# === Pnpm ===
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# === OMP ===
eval "$(oh-my-posh init zsh --config '~/.config/omp/gruvbox.omp.json')"


# pnpm
export PNPM_HOME="/home/kasper/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end
