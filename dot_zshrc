  # === Path ===
  export PATH="$HOME/.local/bin:$HOME/.dotnet/tools:$PATH"

  # === Environment ===
  export EDITOR=nvim
  export VISUAL=nvim

  # === History ===
  HISTFILE=~/.histfile
  HISTSIZE=10000
  SAVEHIST=10000
  setopt HIST_IGNORE_DUPS
  setopt HIST_IGNORE_SPACE
  setopt SHARE_HISTORY

  # === Completion ===
  autoload -Uz compinit
  compinit
  zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

  # === Aliases ===
  alias ff='fastfetch'

  alias fixmon='for m in $(hyprctl monitors -j | jq -r ".[].name"); do hyprctl keyword monitor "$m,disable";
   done && sleep 0.5 && hyprctl reload'

  alias conf='cd ~/.config'
  alias lc='cd ~/.local'

  alias conf_nvim='cd ~/.config/nvim'
  alias conf_hypr='cd ~/.config/hypr'
  alias conf_way='cd ~/.config/waybar'
  alias conf_rofi='cd ~/.config/rofi'

  alias doc='cd ~/Documents'
  alias pic='cd ~/Pictures'
  alias dl='cd ~/Downloads'

  alias proj_net='cd ~/Documents/DotNetProjects'

  alias sdtui='systemd-manager-tui'

  alias restartdisc='pkill -f "electron.*equibop"; sleep 3; equibop &'

  # === Prompt ===
  eval "$(oh-my-posh init zsh --config ~/.config/omp/theme.omp.json)"
