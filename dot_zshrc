# === Anything that requires console input must go above this block ===

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# === Env ===

export PATH="$HOME/.local/bin:$HOME/.dotnet/tools:$PATH"
export ZSH="$HOME/.oh-my-zsh"
export EDITOR=nvim
export VISUAL=nvim

# === Theme ===

ZSH_THEME="powerlevel10k/powerlevel10k"

# === Oh-my-zsh ===

zstyle ':omz:update' mode reminder

DISABLE_AUTO_TITLE="true"
COMPLETION_WAITING_DOTS="true"

plugins=(git aliases archlinux chezmoi colorize zsh-autosuggestions zsh-syntax-highlighting eza zoxide)

source $ZSH/oh-my-zsh.sh

# === Custom Aliases ===

alias nvimcfg='cd ~/.config/nvim && nvim .'
alias cfg='cd ~/.config && nvim .'

# === Prompt ===

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# === Pnpm ===

export PNPM_HOME="/home/kasper/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
